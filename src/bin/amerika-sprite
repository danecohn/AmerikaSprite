#!/bin/sh
# Sprite launcher: the page lives in /usr/share/amerika-sprite/app, hosted by the shared Studio web shell.
APPDIR=${AMERIKA_SPRITE_APP_DIR:-/usr/share/amerika-sprite/app}
exec amerika-studio-webview --app sprite --dir "$APPDIR" --title "Cohnsoft Sprite" --icon artemis-sprite --app-id org.amerika.Sprite "$@"
